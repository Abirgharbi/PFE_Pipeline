        <mxCell id="gh_svc" value="github_service.py&#xa;&#xa;• Rate limit handling&#xa;• Retry logic&#xa;• Token auth&#xa;• Pagination helper" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff;strokeColor=#999;fontSize=10;align=left;spacingLeft=8;verticalAlign=top;spacingTop=5;dashed=1;" vertex="1" parent="1">
