          <mxGeometry x="80" y="100" width="200" height="80" as="geometry" />
        </mxCell>

        <!-- Token Computation -->
        <mxCell id="token-comp" value="&lt;b&gt;Token Computation&lt;/b&gt;&#xa;&#xa;token = SHA1(&#xa;  clientAppName +&#xa;  serviceName +&#xa;  apiKey +&#xa;  timestamp +&#xa;  nonce&#xa;)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;verticalAlign=top;spacingTop=5;align=left;spacingLeft=10;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="80" y="240" width="200" height="160" as="geometry" />
        </mxCell>

        <!-- Input JSON -->
        <mxCell id="input-json" value="&lt;b&gt;Input JSON&lt;/b&gt;&#xa;st_ready_issues_stm32cubeh7.json&#xa;(5000+ items)" style="shape=document;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;verticalAlign=middle;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="80" y="450" width="200" height="80" as="geometry" />
        </mxCell>

        <!-- Split -->
        <mxCell id="split" value="&lt;b&gt;Split into batches&lt;/b&gt;&#xa;max 1000 items/request" style="rhombus;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="370" y="440" width="180" height="100" as="geometry" />
        </mxCell>

        <!-- POST Request -->
        <mxCell id="post-req" value="&lt;b&gt;POST Request Body&lt;/b&gt;&#xa;&#xa;{&#xa;  type: kb-datasource-add&#xa;  clientAppName: mdrf_st_...&#xa;  datasourceId: 19896&#xa;  rootTagPath: issues&#xa;  remoteUser: abir@st.com&#xa;  token: &lt;HMAC&gt;&#xa;  timestamp: 1717560000&#xa;  nonce: abc123&#xa;  data: [...] (≤1000)&#xa;}" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;align=left;spacingLeft=10;verticalAlign=top;spacingTop=5;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="630" y="200" width="220" height="220" as="geometry" />
        </mxCell>

        <!-- API Endpoint -->
        <mxCell id="api" value="&lt;b&gt;ST AI Bridge API&lt;/b&gt;&#xa;&#xa;POST /chatgpt/api/client-apps&#xa;&#xa;HTTPS (TLS 1.3)&#xa;Verify: token signature" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e6d0de;strokeColor=#996185;verticalAlign=middle;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="950" y="200" width="220" height="120" as="geometry" />
        </mxCell>

        <!-- KB #793 -->
        <mxCell id="kb" value="&lt;b&gt;Knowledge Base #793&lt;/b&gt;&#xa;&#xa;ST GitHub Analyzer&#xa;20 datasources&#xa;(5 series × 4 types)" style="shape=cylinder3;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;verticalAlign=middle;fontSize=11;size=12;" vertex="1" parent="1">
          <mxGeometry x="950" y="420" width="220" height="140" as="geometry" />
        </mxCell>

        <!-- Response -->
        <mxCell id="response" value="&lt;b&gt;Response&lt;/b&gt;&#xa;&#xa;200 OK: {success: true}&#xa;429: Rate limit (retry)&#xa;500: Server error (retry)&#xa;403: Invalid token" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;align=left;spacingLeft=10;verticalAlign=top;spacingTop=5;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="950" y="600" width="220" height="110" as="geometry" />
