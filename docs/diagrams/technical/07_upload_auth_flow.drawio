        <mxCell id="a3" style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeWidth=2;" edge="1" parent="1" source="token-comp" target="post-req">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="a4" style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeWidth=2;" edge="1" parent="1" source="split" target="post-req">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="a5" value="HTTPS" style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeWidth=3;strokeColor=#9673a6;" edge="1" parent="1" source="post-req" target="api">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
