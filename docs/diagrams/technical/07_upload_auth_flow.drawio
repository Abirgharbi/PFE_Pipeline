        <mxCell id="a7" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeWidth=1;dashed=1;" edge="1" parent="1" source="api" target="response">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- Retry loop -->
        <mxCell id="retry" value="Retry (3x)&#xa;backoff" style="curved=1;endArrow=classic;html=1;strokeWidth=1;strokeColor=#b85450;dashed=1;" edge="1" parent="1" source="response" target="post-req">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
