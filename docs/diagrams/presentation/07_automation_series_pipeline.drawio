        <!-- Arrow step4 to alfred -->
        <mxCell id="a-s4-alfred" value="HTTPS POST" style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeColor=#c62828;strokeWidth=2;" edge="1" source="step4" target="alfred-api" parent="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- Persona output -->
        <mxCell id="persona-out" value="&lt;b&gt;Persona: ST GitHub Analyzer&lt;/b&gt;&#xa;&#xa;Outil KB: Hybrid Search&#xa;Outil fallback: Alfred&#xa;&#xa;→ Répond aux questions STM32" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;align=center;" vertex="1" parent="1">
          <mxGeometry x="1310" y="840" width="230" height="130" as="geometry" />
