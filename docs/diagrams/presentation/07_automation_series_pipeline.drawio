        <mxCell id="a7-ids" value="sauvegarde IDs" style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeColor=#f9a825;strokeWidth=1;dashed=1;" edge="1" source="step7" target="ids-file" parent="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- Right side: GitHub Source -->
        <mxCell id="github-src" value="&lt;b&gt;GitHub STMicroelectronics&lt;/b&gt;&#xa;&#xa;Repos actifs (G4, L0, L1, L4, L5, N6, U0, U3…)&#xa;Issues · PRs · Commits · Files · Submodules" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#333333;fontSize=11;align=center;" vertex="1" parent="1">
          <mxGeometry x="600" y="250" width="430" height="100" as="geometry" />
        </mxCell>

        <!-- Arrow github to step1 -->
        <mxCell id="a-gh1" value="git pull / GitHub API" style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeColor=#333333;strokeWidth=2;" edge="1" source="github-src" target="step1" parent="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- Alfred API external -->
        <mxCell id="alfred-api" value="&lt;b&gt;Alfred Vision API&lt;/b&gt;&#xa;api-ai-bridge.st.com&#xa;&#xa;Client: mdrf_stgithub_analyzer&#xa;→ image URL → description + OCR" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fce4ec;strokeColor=#c62828;fontSize=11;align=center;" vertex="1" parent="1">
          <mxGeometry x="600" y="720" width="430" height="110" as="geometry" />
