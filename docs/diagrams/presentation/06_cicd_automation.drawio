        <!-- Arrow job2 to API -->
        <mxCell id="a-api" value="HTTPS POST&#xa;(delete + add)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeWidth=2;strokeColor=#9673a6;" edge="1" parent="1" source="j2s3" target="api-box">
          <mxGeometry relative="1" as="geometry" />
