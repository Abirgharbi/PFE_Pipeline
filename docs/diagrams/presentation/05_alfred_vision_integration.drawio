<?xml version="1.0" encoding="UTF-8"?>
<mxfile host="app.diagrams.net" modified="2026-06-05T10:00:00.000Z" agent="STM32Cube PFE" version="21.0.0">
  <diagram id="pres-alfred" name="Presentation - Alfred Vision AI Integration">
    <mxGraphModel dx="1200" dy="700" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1200" pageHeight="700" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="title" value="Alfred Vision AI - Image-to-Text Enrichment" style="text;html=1;align=center;fontSize=18;fontStyle=1;fontColor=#1a237e;" vertex="1" parent="1">
          <mxGeometry x="300" y="10" width="500" height="40" as="geometry" />
        </mxCell>
        <!-- Problem -->
        <mxCell id="problem" value="❌ Problem: Images in GitHub Issues&#xa;&#xa;• Error dialogs (screenshots)&#xa;• Logic analyzer captures&#xa;• CubeMX configuration screenshots&#xa;• Oscilloscope traces&#xa;&#xa;→ Invisible to text-based RAG search" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffcdd2;strokeColor=#c62828;fontSize=11;align=left;spacingLeft=10;verticalAlign=top;spacingTop=8;" vertex="1" parent="1">
          <mxGeometry x="40" y="80" width="320" height="170" as="geometry" />
        </mxCell>
        <!-- Alfred API -->
        <mxCell id="alfred" value="🤖 Alfred Vision API&#xa;&#xa;• Multimodal LLM analysis&#xa;• OCR text extraction&#xa;• Semantic image description&#xa;• ST-specific context awareness&#xa;&#xa;API: ST AI Bridge (Vision service)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1f5fe;strokeColor=#0277bd;fontSize=11;align=left;spacingLeft=10;verticalAlign=top;spacingTop=8;" vertex="1" parent="1">
          <mxGeometry x="440" y="80" width="320" height="170" as="geometry" />
        </mxCell>
        <!-- Solution -->
        <mxCell id="solution" value="✅ Solution: Enriched Text&#xa;&#xa;• [IMAGE DESCRIPTION]: semantic content&#xa;• [IMAGE TEXT]: OCR-extracted text&#xa;&#xa;→ Now searchable by RAG engine&#xa;→ Error messages become queryable" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#c8e6c9;strokeColor=#2e7d32;fontSize=11;align=left;spacingLeft=10;verticalAlign=top;spacingTop=8;" vertex="1" parent="1">
          <mxGeometry x="840" y="80" width="320" height="170" as="geometry" />
        </mxCell>
        <!-- Flow -->
        <mxCell id="flow1" value="st_ready_issues_{repo}.json&#xa;(contains image URLs)" style="shape=document;whiteSpace=wrap;html=1;size=0.1;fillColor=#fff3e0;strokeColor=#e65100;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="40" y="340" width="250" height="60" as="geometry" />
        </mxCell>
        <mxCell id="flow2" value="enrich_json_images_with_alfred.py&#xa;&#xa;1. Scan JSON for image URLs&#xa;2. Send each to Alfred Vision API&#xa;3. Get description + OCR text&#xa;4. Append to issue body text" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e8eaf6;strokeColor=#283593;fontSize=10;align=left;spacingLeft=10;verticalAlign=top;spacingTop=8;" vertex="1" parent="1">
          <mxGeometry x="370" y="310" width="300" height="120" as="geometry" />
        </mxCell>
        <mxCell id="flow3" value="st_ready_issues_{repo}&#xa;_with_alfred_image_text.json&#xa;(enriched version)" style="shape=document;whiteSpace=wrap;html=1;size=0.1;fillColor=#c8e6c9;strokeColor=#2e7d32;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="750" y="340" width="280" height="60" as="geometry" />
        </mxCell>
        <mxCell id="flow4" value="Upload to KB&#xa;(replaces original&#xa;issues datasource)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#1a237e;fontColor=#fff;strokeColor=#000;fontSize=11;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="750" y="460" width="280" height="60" as="geometry" />
        </mxCell>
        <!-- Example -->
        <mxCell id="example" value="Example Transformation:&#xa;&#xa;Before: &quot;See attached screenshot showing the error&quot;&#xa;         ![image](https://user-images/.../error.png)&#xa;&#xa;After:  &quot;See attached screenshot showing the error&quot;&#xa;         ![image](https://user-images/.../error.png)&#xa;         [IMAGE DESCRIPTION]: STM32CubeIDE error dialog showing&#xa;         &quot;HAL_SPI_ERROR_OVR&quot; overrun error during DMA transfer,&#xa;         with SPI1 configuration visible in background.&#xa;         [IMAGE TEXT]: Error: HAL_SPI_ERROR_OVR&#xa;         SPI Overrun Error detected during DMA circular mode" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff;strokeColor=#999;fontSize=9;fontFamily=Courier New;align=left;spacingLeft=8;verticalAlign=top;spacingTop=5;" vertex="1" parent="1">
          <mxGeometry x="40" y="470" width="620" height="200" as="geometry" />
        </mxCell>
        <!-- Arrows -->
        <mxCell id="a1" style="strokeWidth=2;strokeColor=#e65100;" edge="1" source="problem" target="alfred" parent="1"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="a2" style="strokeWidth=2;strokeColor=#0277bd;" edge="1" source="alfred" target="solution" parent="1"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="a3" style="strokeWidth=2;strokeColor=#283593;" edge="1" source="flow1" target="flow2" parent="1"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="a4" style="strokeWidth=2;strokeColor=#283593;" edge="1" source="flow2" target="flow3" parent="1"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="a5" style="strokeWidth=2;strokeColor=#1a237e;" edge="1" source="flow3" target="flow4" parent="1"><mxGeometry relative="1" as="geometry" /></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
