          <mxGeometry x="360" y="20" width="900" height="40" as="geometry" />
        </mxCell>

        <mxCell id="trigger" value="&lt;b&gt;TRIGGER&lt;/b&gt;&#xa;Manual or Scheduled&#xa;(Series: G4/L0/L1/L4/L5/N6/U0/U3...)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;align=center;verticalAlign=middle;" vertex="1" parent="1">
