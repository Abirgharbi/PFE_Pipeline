        </mxCell>

        <mxCell id="prepare" value="&lt;b&gt;1) PREPARE&lt;/b&gt;&#xa;&#xa;Run_Single_Series_Full_Pipeline_And_Upload.ps1&#xa;-Mode Prepare&#xa;&#xa;Does:&#xa;- Sync repos + submodules&#xa;- Ingest/Clean/Enrich/Similarity&#xa;- Export ST-ready JSON&#xa;- Alfred image enrichment&#xa;- PDF patching" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;align=left;spacingLeft=10;verticalAlign=top;spacingTop=8;" vertex="1" parent="1">
          <mxGeometry x="340" y="120" width="300" height="240" as="geometry" />
        </mxCell>

        <mxCell id="validate" value="&lt;b&gt;2) VALIDATE&lt;/b&gt;&#xa;&#xa;Quality gates:&#xa;- validate_schemas.py&#xa;- Placeholder check&#xa;  (no IMAGE DESCRIPTION UNAVAILABLE)&#xa;- summary_*.json counts coherent&#xa;&#xa;If fail: stop and fix&#xa;If pass: continue upload" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;align=left;spacingLeft=10;verticalAlign=top;spacingTop=8;" vertex="1" parent="1">
          <mxGeometry x="700" y="120" width="300" height="240" as="geometry" />
        </mxCell>

        <mxCell id="upload" value="&lt;b&gt;3) UPLOAD&lt;/b&gt;&#xa;&#xa;-Mode Upload&#xa;&#xa;Add_Data_Source_Files.py&#xa;- operation new (create DS)&#xa;or operation add (existing DS)&#xa;- json-split-size 1000&#xa;- Upload parent + drivers/subrepos&#xa;&#xa;Output: upload_datasource_ids_&lt;serie&gt;.json" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=12;align=left;spacingLeft=10;verticalAlign=top;spacingTop=8;" vertex="1" parent="1">
