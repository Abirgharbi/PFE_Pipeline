<mxfile host="65bd71144e">
    <diagram id="evaluation-formulas" name="Alfred and Persona Evaluation Formulas">
        <mxGraphModel dx="1573" dy="961" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1900" pageHeight="1350" math="0" shadow="0">
            <root>
                <mxCell id="0"/>
                <mxCell id="1" parent="0"/>
                <mxCell id="title" value="&lt;b&gt;Alfred and ST GitHub Analyzer Persona Evaluation - Metrics and Formulas&lt;/b&gt;" style="text;html=1;align=center;fontSize=18;fontColor=#03234B;strokeColor=none;fillColor=none;" parent="1" vertex="1">
                    <mxGeometry x="200" y="20" width="1300" height="40" as="geometry"/>
                </mxCell>
                <mxCell id="b1-zone" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fce4ec;strokeColor=#c62828;arcSize=3;strokeWidth=2;" parent="1" vertex="1">
                    <mxGeometry x="60" y="80" width="800" height="440" as="geometry"/>
                </mxCell>
                <mxCell id="b1-title" value="&lt;b&gt;1) Alfred Coherence Score (validate_alfred_coherence.py)&lt;/b&gt;" style="text;html=1;align=left;fontSize=14;fontColor=#c62828;strokeColor=none;fillColor=none;" parent="1" vertex="1">
                    <mxGeometry x="75" y="88" width="600" height="25" as="geometry"/>
                </mxCell>
                <mxCell id="f1-formula" value="&lt;b&gt;Final coherence score:&lt;/b&gt;&#xa;&#xa;   C = clamp01( base * (1 - penalty) )&#xa;&#xa;&lt;b&gt;Base score:&lt;/b&gt;&#xa;&#xa;   base = ( alpha * L + beta * S_sem ) / ( alpha + beta )&#xa;&#xa;&lt;b&gt;Lexical score:&lt;/b&gt;&#xa;&#xa;   L = 0.7 * O_desc + 0.3 * O_ocr&#xa;&#xa;&lt;b&gt;Contradiction penalty:&lt;/b&gt;&#xa;&#xa;   penalty = clamp01( gamma * P_contradiction )" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff0f3;strokeColor=#c62828;align=left;spacingLeft=15;verticalAlign=top;spacingTop=10;fontSize=12;fontFamily=Courier New;" parent="1" vertex="1">
                    <mxGeometry x="90" y="120" width="430" height="260" as="geometry"/>
                </mxCell>
                <mxCell id="f1-vars" value="&lt;b&gt;Variables&lt;/b&gt;&#xa;&#xa;C = final coherence score [0, 1]&#xa;L = lexical score (token overlap proxy)&#xa;S_sem = semantic similarity score&#xa;O_desc = overlap(description, context)&#xa;O_ocr = overlap(OCR text, context)&#xa;P_contradiction = NLI contradiction probability&#xa;alpha = lexical weight (alpha_lexical)&#xa;beta = semantic weight (beta_semantic)&#xa;gamma = penalty factor (gamma_contradiction)&#xa;&#xa;&lt;b&gt;Reliability classes:&lt;/b&gt;&#xa;EXCELLENT &gt;= 0.75&#xa;GOOD &gt;= 0.55&#xa;ACCEPTABLE &gt;= 0.35&#xa;INSUFFICIENT &lt; 0.35" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff0f3;strokeColor=#c62828;align=left;spacingLeft=10;verticalAlign=top;spacingTop=10;fontSize=11;" parent="1" vertex="1">
                    <mxGeometry x="530" y="120" width="305" height="260" as="geometry"/>
                </mxCell>
                <mxCell id="f1-results" value="&lt;b&gt;Observed results (alfred_coherence_summary.json)&lt;/b&gt;&#xa;&#xa;PDF figures: 242 evaluated | 58.3% low coherence | avg C = 0.18&#xa;Issue images: 200 evaluated | 1.5% low coherence | avg C = 0.50&#xa;&#xa;-&gt; GitHub issue screenshots are well anchored in context&#xa;-&gt; PDF figures remain weaker due to limited page context" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffeef2;strokeColor=#c62828;align=left;spacingLeft=10;verticalAlign=middle;fontSize=11;" parent="1" vertex="1">
                    <mxGeometry x="90" y="390" width="745" height="120" as="geometry"/>
                </mxCell>
                <mxCell id="b2-zone" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e8f5e9;strokeColor=#2e7d32;arcSize=3;strokeWidth=2;" parent="1" vertex="1">
                    <mxGeometry x="900" y="80" width="900" height="400" as="geometry"/>
                </mxCell>
                <mxCell id="b2-title" value="&lt;b&gt;2) KB Strategy Score (summarize_kb_strategy_results.py)&lt;/b&gt;" style="text;html=1;align=left;fontSize=14;fontColor=#2e7d32;strokeColor=none;fillColor=none;" parent="1" vertex="1">
                    <mxGeometry x="915" y="88" width="650" height="25" as="geometry"/>
                </mxCell>
                <mxCell id="f2-formula" value="&lt;b&gt;Weighted KB strategy score:&lt;/b&gt;&#xa;&#xa;   S = 0.40 * R_top1&#xa;       + 0.20 * R_top3&#xa;       + 0.35 * R_answer&#xa;       - 0.15 * R_hallucination&#xa;       - 0.05 * (1 - B_latency)&#xa;&#xa;&lt;b&gt;Normalized latency bonus:&lt;/b&gt;&#xa;&#xa;   B_latency = 1 - (latency - min_lat) / (max_lat - min_lat)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f1f8f2;strokeColor=#2e7d32;align=left;spacingLeft=15;verticalAlign=top;spacingTop=10;fontSize=12;fontFamily=Courier New;" parent="1" vertex="1">
                    <mxGeometry x="930" y="120" width="420" height="270" as="geometry"/>
                </mxCell>
                <mxCell id="f2-vars" value="&lt;b&gt;Variables&lt;/b&gt;&#xa;&#xa;R_top1 = relevant doc rate in top-1&#xa;R_top3 = relevant doc rate in top-3&#xa;R_answer = final answer correctness rate&#xa;R_hallucination = hallucination rate&#xa;B_latency = latency bonus [0, 1]&#xa;            (1 = fastest, 0 = slowest)&#xa;&#xa;&lt;b&gt;Strategies tested:&lt;/b&gt;&#xa;S0_CURRENT (baseline)&#xa;S1_RECALL&#xa;S2_BALANCED&#xa;S3_PRECISION&#xa;S4_SEMANTIC_HEAVY&#xa;S5_KEYWORD_HEAVY" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f1f8f2;strokeColor=#2e7d32;align=left;spacingLeft=10;verticalAlign=top;spacingTop=10;fontSize=11;" parent="1" vertex="1">
                    <mxGeometry x="1370" y="120" width="390" height="270" as="geometry"/>
                </mxCell>
                <mxCell id="f2-results" value="&lt;b&gt;Goal: choose the strategy with the highest S score for production persona settings.&lt;/b&gt;&#xa;Weighting logic: answer correctness is heavily weighted (35%), top-1 relevance is primary (40%), and hallucination is penalized (-15%)." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eaf7ec;strokeColor=#2e7d32;align=left;spacingLeft=10;verticalAlign=middle;fontSize=11;" parent="1" vertex="1">
                    <mxGeometry x="930" y="405" width="830" height="65" as="geometry"/>
                </mxCell>
                <mxCell id="b3-zone" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e3f2fd;strokeColor=#1565c0;arcSize=3;strokeWidth=2;" parent="1" vertex="1">
                    <mxGeometry x="60" y="560" width="800" height="410" as="geometry"/>
                </mxCell>
                <mxCell id="b3-title" value="&lt;b&gt;3) Quality Index (QI) - Offline vs Online Persona&lt;/b&gt;" style="text;html=1;align=left;fontSize=14;fontColor=#1565c0;strokeColor=none;fillColor=none;" parent="1" vertex="1">
                    <mxGeometry x="75" y="568" width="650" height="25" as="geometry"/>
                </mxCell>
                <mxCell id="f3-formula" value="&lt;b&gt;Offline normalization (0-7 to 0-100):&lt;/b&gt;&#xa;&#xa;   QI_offline = ( total_0_to_7 / 7 ) * 100&#xa;&#xa;&lt;b&gt;Online score (platform Quality Index):&lt;/b&gt;&#xa;&#xa;   QI_online in [0, 100]&#xa;&#xa;&lt;b&gt;Comparison delta (points):&lt;/b&gt;&#xa;&#xa;   Delta = QI_online - QI_offline" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e8f4fd;strokeColor=#1565c0;align=left;spacingLeft=15;verticalAlign=top;spacingTop=10;fontSize=12;fontFamily=Courier New;" parent="1" vertex="1">
                    <mxGeometry x="90" y="600" width="430" height="250" as="geometry"/>
                </mxCell>
                <mxCell id="f3-crit" value="&lt;b&gt;Offline rubric (max 7 points):&lt;/b&gt;&#xa;&#xa;1. Source relevance in top-1 /1&#xa;2. Relevant source present in top-3 /1&#xa;3. Factual correctness of final answer /2&#xa;4. No hallucination /1&#xa;5. Coverage of user question /1&#xa;6. Formal quality and clarity /1&#xa;&#xa;Total: /7 then normalized to /100 with QI_offline&#xa;&#xa;&lt;b&gt;Delta interpretation:&lt;/b&gt;&#xa;Delta &gt; 0 : persona outperforms manual baseline&#xa;Delta &lt; 0 : persona underperforms manual baseline&#xa;Delta approx 0 : scoring alignment" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e8f4fd;strokeColor=#1565c0;align=left;spacingLeft=10;verticalAlign=top;spacingTop=10;fontSize=11;" parent="1" vertex="1">
                    <mxGeometry x="545" y="600" width="290" height="295" as="geometry"/>
                </mxCell>
                <mxCell id="b4-zone" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ede7f6;strokeColor=#4527a0;arcSize=3;strokeWidth=2;" parent="1" vertex="1">
                    <mxGeometry x="900" y="560" width="900" height="410" as="geometry"/>
                </mxCell>
                <mxCell id="b4-title" value="&lt;b&gt;4) Persona Comparison: ST GitHub Analyzer vs Direct Alfred&lt;/b&gt;" style="text;html=1;align=left;fontSize=14;fontColor=#4527a0;strokeColor=none;fillColor=none;" parent="1" vertex="1">
                    <mxGeometry x="915" y="568" width="750" height="25" as="geometry"/>
                </mxCell>
                <mxCell id="f4-table" value="&lt;br&gt;&lt;br&gt;&lt;table border=&quot;1&quot; cellpadding=&quot;6&quot; style=&quot;border-collapse:collapse;font-size:11px;width:100%;&quot;&gt;&lt;tbody&gt;&lt;tr style=&quot;background: rgb(69, 39, 160); color: white;&quot;&gt;  &lt;th&gt;&lt;font style=&quot;color: rgb(255, 255, 255);&quot;&gt;Criterion&lt;/font&gt;&lt;/th&gt;  &lt;th&gt;&lt;font style=&quot;color: rgb(255, 255, 255);&quot;&gt;Direct Alfred&lt;/font&gt;&lt;/th&gt;  &lt;th&gt;&lt;font style=&quot;color: rgb(255, 255, 255);&quot;&gt;Persona (KB + Alfred fallback)&lt;/font&gt;&lt;/th&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;&lt;b&gt;Answer source&lt;/b&gt;&lt;/td&gt;&lt;td&gt;Generic LLM chat memory&lt;/td&gt;&lt;td&gt;Indexed STM32Cube KB + LLM&lt;/td&gt;&lt;/tr&gt;&lt;tr style=&quot;background: rgb(243, 229, 245);&quot;&gt;&lt;td&gt;&lt;b&gt;Factual grounding&lt;/b&gt;&lt;/td&gt;&lt;td&gt;Model memory only&lt;/td&gt;&lt;td&gt;Issues + Resolver + Diagnostic Cards&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;&lt;b&gt;Image coverage&lt;/b&gt;&lt;/td&gt;&lt;td&gt;Only if URL is provided&lt;/td&gt;&lt;td&gt;Pre-enriched with Alfred Vision&lt;/td&gt;&lt;/tr&gt;&lt;tr style=&quot;background: rgb(243, 229, 245);&quot;&gt;&lt;td&gt;&lt;b&gt;Hallucination risk&lt;/b&gt;&lt;/td&gt;&lt;td&gt;Higher (no RAG)&lt;/td&gt;&lt;td&gt;Lower (structured KB-RAG)&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;&lt;b&gt;Latency&lt;/b&gt;&lt;/td&gt;&lt;td&gt;Lower&lt;/td&gt;&lt;td&gt;Moderate (KB lookup + LLM)&lt;/td&gt;&lt;/tr&gt;&lt;tr style=&quot;background: rgb(243, 229, 245);&quot;&gt;&lt;td&gt;&lt;b&gt;STM32 specificity&lt;/b&gt;&lt;/td&gt;&lt;td&gt;General&lt;/td&gt;&lt;td&gt;High (47 repos indexed)&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;&lt;b&gt;Fallback policy&lt;/b&gt;&lt;/td&gt;&lt;td&gt;N/A&lt;/td&gt;&lt;td&gt;Call Alfred only when KB has no relevant answer&lt;/td&gt;&lt;/tr&gt;&lt;/tbody&gt;&lt;/table&gt;" style="text;html=1;align=center;verticalAlign=top;resizable=0;points=[];strokeColor=#4527a0;fillColor=#f9f4ff;rounded=1;fontSize=11;" parent="1" vertex="1">
                    <mxGeometry x="920" y="610" width="840" height="240" as="geometry"/>
                </mxCell>
                <mxCell id="b5-zone" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff8e1;strokeColor=#e65100;arcSize=3;strokeWidth=2;" parent="1" vertex="1">
                    <mxGeometry x="60" y="990" width="1740" height="200" as="geometry"/>
                </mxCell>
                <mxCell id="b5-title" value="&lt;b&gt;5) Pipeline Metrics Summary - Overview&lt;/b&gt;" style="text;html=1;align=left;fontSize=14;fontColor=#e65100;strokeColor=none;fillColor=none;" parent="1" vertex="1">
                    <mxGeometry x="75" y="998" width="700" height="25" as="geometry"/>
                </mxCell>
                <mxCell id="m1" value="&lt;b&gt;Alfred Coherence&lt;/b&gt;&#xa;Issue images: C approx 0.50&#xa;PDF figures: C approx 0.18&#xa;Low threshold: C &lt; 0.35&#xa;&#xa;Need better PDF context" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fce4ec;strokeColor=#c62828;fontSize=11;align=center;" parent="1" vertex="1">
                    <mxGeometry x="90" y="1030" width="230" height="140" as="geometry"/>
                </mxCell>
                <mxCell id="m2" value="&lt;b&gt;KB Strategy&lt;/b&gt;&#xa;Score S in [0, 1]&#xa;Weighted: top1 40%&#xa;answer 35%&#xa;top3 20%&#xa;hallucination penalty 15%" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e8f5e9;strokeColor=#2e7d32;fontSize=11;align=center;" parent="1" vertex="1">
                    <mxGeometry x="350" y="1030" width="230" height="140" as="geometry"/>
                </mxCell>
                <mxCell id="m3" value="&lt;b&gt;Quality Index&lt;/b&gt;&#xa;Offline: /7 to /100&#xa;Online: ST QI [0, 100]&#xa;Delta = online - offline&#xa;&#xa;Compare persona runs&#xa;against manual scoring" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e3f2fd;strokeColor=#1565c0;fontSize=11;align=center;" parent="1" vertex="1">
                    <mxGeometry x="610" y="1030" width="230" height="140" as="geometry"/>
                </mxCell>
                <mxCell id="m4" value="&lt;b&gt;Schema Validity&lt;/b&gt;&#xa;validate_schemas.py&#xa;blocking quality gate&#xa;&#xa;is_valid = True required&#xa;0 unresolved placeholders&#xa;summary_*.json checks" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f3e5f5;strokeColor=#6a1b9a;fontSize=11;align=center;" parent="1" vertex="1">
                    <mxGeometry x="870" y="1030" width="230" height="140" as="geometry"/>
                </mxCell>
                <mxCell id="m5" value="&lt;b&gt;Series Coverage&lt;/b&gt;&#xa;Active repos: G4 L0 L1 L4&#xa;L5 N6 U0 U3 WB WBA WL3&#xa;&#xa;Issues + files + drivers&#xa;and subrepos covered" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff8e1;strokeColor=#e65100;fontSize=11;align=center;" parent="1" vertex="1">
                    <mxGeometry x="1130" y="1030" width="230" height="140" as="geometry"/>
                </mxCell>
                <mxCell id="m6" value="&lt;b&gt;Evaluation Tools&lt;/b&gt;&#xa;test_stats_issues_v2.py&#xa;test_tfidf_search_*.py&#xa;run_persona_kb_eval.py&#xa;compare_offline_online.py&#xa;validate_alfred_coherence.py" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e8eaf6;strokeColor=#283593;fontSize=11;align=center;" parent="1" vertex="1">
                    <mxGeometry x="1390" y="1030" width="230" height="140" as="geometry"/>
                </mxCell>
                <mxCell id="f1-trust-box" value="&lt;b&gt;Contextual trust formula&lt;/b&gt;&#xa;Trust(%) = (# items with C &gt;= tau) / N_evaluated * 100&#xa;Issue screenshots: (200 - 3) / 200 = 98.5%&#xa;PDF figures: (242 - 141) / 242 = 41.7%" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e0f7fa;strokeColor=#00838f;fontSize=10;align=left;spacingLeft=8;verticalAlign=middle;" parent="1" vertex="1">
                    <mxGeometry x="450" y="420" width="360" height="60" as="geometry"/>
                </mxCell>
                <mxCell id="f4-gain-box" value="&lt;b&gt;Comparative gain formula&lt;/b&gt;&#xa;Gain(%) = (Score_persona - Score_alfred) / Score_alfred * 100&#xa;= (8.1 - 5.8) / 5.8 * 100 = 39.7% ~ 39%" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e8f5e9;strokeColor=#2e7d32;fontSize=10;align=left;spacingLeft=8;verticalAlign=middle;" parent="1" vertex="1">
                    <mxGeometry x="1260" y="880" width="510" height="56" as="geometry"/>
                </mxCell>
            </root>
        </mxGraphModel>
    </diagram>
</mxfile>