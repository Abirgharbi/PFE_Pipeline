        <mxCell id="a_issue1" value="Issue: GitHub REST rate limit (403) on hosted ingestion\nMitigation: enforce authenticated GITHUB_TOKEN + preflight" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffebee;strokeColor=#c62828;fontColor=#b71c1c;fontSize=12;" vertex="1" parent="laneA">
